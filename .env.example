# ---- Ports ----

# External port on which nginx will be accessible from the host
APP_PORT=8080

# Database port on the host — dev only (for IDE connections)
FORWARD_DB_PORT=5432

# ---- Database ----

# Database name
DB_NAME=app

# Database user
DB_USER=app

# Database password — change in production!
DB_PASSWORD=change_me_in_production

# ---- Host User ----

# Used to pass UID/GID into dev containers so files created by containers
# are owned by the host user (no permission issues).
# Get current values: id -u && id -g
HOST_USER_UID=1000
HOST_USER_GID=1000

# ---- Composer Cache ----

# Path to Composer cache on the host — speeds up repeated composer install
HOST_COMPOSER_CACHE_DIR=~/.cache/composer

# Path to Composer cache inside the container
CONTAINER_COMPOSER_CACHE_DIR=/.composer/cache
