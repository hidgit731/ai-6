# ---- Symfony ----

###> symfony/framework-bundle ###
# Application environment: dev | prod | test
APP_ENV=dev
# Application secret key — generate with: php bin/console secrets:generate-keys
APP_SECRET=change_me_in_production
###< symfony/framework-bundle ###

# Base URL used by Symfony router to generate absolute URLs in non-HTTP contexts (CLI commands)
DEFAULT_URI=http://localhost:8080

# ---- Database ----

# Database name
DB_NAME=app

# Database user
DB_USER=app

# Database password — change in production!
DB_PASSWORD=change_me_in_production

# Database port inside Docker network
DB_PORT=5432

###> doctrine/doctrine-bundle ###
# Full database URL assembled from variables above.
# You can override it directly or rely on the composed form:
# DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@postgres:${DB_PORT}/${DB_NAME}?serverVersion=18&charset=utf8"
DATABASE_URL="postgresql://app:change_me_in_production@postgres:5432/app?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###
